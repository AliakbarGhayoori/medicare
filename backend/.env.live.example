# MediCare AI — local development (real Firebase auth + real AI provider).
# Copy to backend/.env.live (git-ignored) and fill in keys. Then either:
#   MEDICARE_ENV_FILE=.env.live .venv/bin/python -m uvicorn src.main:app --host 127.0.0.1 --port 8000
# or run everything in Docker from the repo root:  docker compose up -d
# For offline work set AUTH_MODE=mock and MOCK_AI=true (no keys needed).
ENVIRONMENT=development
AUTH_MODE=firebase
MOCK_AI=false

# MongoDB from the repo's docker-compose.yml (its defaults: root / localdev).
# Pass "--env-file backend/.env.live" to docker compose to use other values.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=localdev
MONGODB_URI=mongodb://root:localdev@localhost:27017/medicare-ai?authSource=admin
MONGODB_DATABASE=medicare-ai

# Firebase Admin service account (backend token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI (OpenRouter chat completions; the backend appends /v1)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME="MediCare AI"
AI_MODEL=google/gemini-4-neon
AI_FALLBACK_MODELS=["openai/gpt-5.4"]
AI_MAX_TOKENS=8192
# AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.3

# Search backend
TAVILY_API_KEY=tvly-...
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_FAVICON=true
TAVILY_MAX_RESULTS=6
TAVILY_TIMEOUT_SECONDS=20
AI_TOOL_MIN_CALLS=2
AI_TOOL_MAX_ROUNDS=6
AI_TOOL_MAX_CALLS=12

# API
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# Limits
CHAT_RATE_LIMIT_PER_HOUR=30
V10_RATE_LIMIT_PER_HOUR=10
