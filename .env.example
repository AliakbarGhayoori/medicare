# MediCare AI — production environment template.
# Copy to .env.prod (git-ignored), fill in real values, then: chmod 600 .env.prod
# Used by: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Never commit real values: the repository is public.

# ─── MongoDB (docker-compose.prod.yml) ────────────────
# Root user created when the data volume is first initialised.
MONGO_ROOT_USERNAME=CHANGE_ME_USER
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# The backend reaches MongoDB by its service name "mongo", with the same user and password.
MONGODB_URI=mongodb://CHANGE_ME_USER:CHANGE_ME_LONG_RANDOM_PASSWORD@mongo:27017/medicare-ai?authSource=admin
MONGODB_DATABASE=medicare-ai

# ─── Firebase Auth ────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── AI (OpenRouter chat completions) ─────────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# The backend appends /v1; requests go to /api/v1/chat/completions.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_APP_NAME=MediCare AI
AI_MODEL=google/gemini-4-neon
# Tried in order when the primary model fails (JSON list or comma-separated).
AI_FALLBACK_MODELS=["openai/gpt-5.4"]
AI_MAX_TOKENS=8192
# Optional: low | medium | high. Unset = the provider's default.
# AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.3

# ─── Search (Tavily) ──────────────────────────────────
TAVILY_API_KEY=tvly-...
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
# Keep false: answers may cite only numbered search results.
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_FAVICON=true
TAVILY_MAX_RESULTS=6
TAVILY_TIMEOUT_SECONDS=20
# Searches required before a health answer, and caps on rounds and total calls.
AI_TOOL_MIN_CALLS=2
AI_TOOL_MAX_ROUNDS=6
AI_TOOL_MAX_CALLS=12

# ─── API Server ──────────────────────────────────────
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=3.0
AUTH_MODE=firebase
MOCK_AI=false
ALLOWED_ORIGINS=["https://your-domain.com"]

# ─── Rate limits and analytics ───────────────────────
CHAT_RATE_LIMIT_PER_HOUR=30
V10_RATE_LIMIT_PER_HOUR=10
ANALYTICS_ENABLED=true
ANALYTICS_STORE_DB=true
